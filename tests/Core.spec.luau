-- Behavioral tests shared by the Luau CLI runner and isolated Roblox Studio QA.
-- This module creates no Roblox instances and makes no network or storage calls.
return function(Validate, RateLimiter)
	local report = { passed = 0, failed = 0, cases = {} }

	local function check(name, callback)
		local ok, problem = pcall(callback)
		table.insert(report.cases, { name = name, passed = ok, error = not ok and tostring(problem) or nil })
		if ok then
			report.passed += 1
		else
			report.failed += 1
		end
	end

	local function accepts(validator, value)
		local ok, reason = validator(value)
		assert(type(ok) == "boolean", "validator must return a boolean")
		assert(reason == nil or type(reason) == "string", "validation reason must be a string or nil")
		assert(ok, tostring(reason or "expected acceptance"))
	end

	local function rejects(validator, value)
		local ok, reason = validator(value)
		assert(type(ok) == "boolean", "validator must return a boolean")
		assert(reason == nil or type(reason) == "string", "validation reason must be a string or nil")
		assert(not ok, "expected rejection")
	end

	local function throws(callback)
		local ok = pcall(callback)
		assert(not ok, "expected an error")
	end

	local function close(actual, expected)
		assert(type(actual) == "number" and math.abs(actual - expected) < 1e-8,
			"expected " .. tostring(expected) .. ", got " .. tostring(actual))
	end

	check("number accepts inclusive bounds and an interior fraction", function()
		local v = Validate.number(-2, 3)
		accepts(v, -2); accepts(v, 3); accepts(v, 0.125)
	end)
	check("number rejects values outside its range", function()
		local v = Validate.number(-2, 3)
		rejects(v, -2.001); rejects(v, 3.001)
	end)
	check("number rejects NaN and both infinities", function()
		local v = Validate.number(-100, 100)
		rejects(v, 0 / 0); rejects(v, math.huge); rejects(v, -math.huge)
	end)
	check("number does not coerce strings, booleans or nil", function()
		local v = Validate.number(0, 10)
		rejects(v, "5"); rejects(v, false); rejects(v, nil)
	end)
	check("integer accepts zero and inclusive integer bounds", function()
		local v = Validate.integer(-2, 2)
		accepts(v, -2); accepts(v, 0); accepts(v, 2)
	end)
	check("integer rejects fractions and nonfinite numbers", function()
		local v = Validate.integer(-10, 10)
		rejects(v, -0.5); rejects(v, 1.5); rejects(v, 0 / 0); rejects(v, math.huge); rejects(v, -math.huge)
	end)
	check("string defaults to allowing empty strings and counts bytes", function()
		local v = Validate.string(4)
		accepts(v, ""); accepts(v, "abcd"); rejects(v, "abcde")
	end)
	check("string applies its explicit minimum byte length", function()
		local v = Validate.string(8, 2)
		rejects(v, ""); rejects(v, "a"); accepts(v, "ab")
	end)
	check("string accepts valid multibyte UTF-8 within its byte budget", function()
		local emoji = utf8.char(0x1F600)
		accepts(Validate.string(4), emoji)
		rejects(Validate.string(3), emoji)
	end)
	check("string rejects malformed, truncated and overlong UTF-8", function()
		local v = Validate.string(20)
		rejects(v, string.char(255))
		rejects(v, string.char(226, 130))
		rejects(v, string.char(192, 175))
	end)
	check("string does not accept other value types", function()
		local v = Validate.string(20)
		rejects(v, 123); rejects(v, {}); rejects(v, true)
	end)
	check("boolean accepts both true and false without coercion", function()
		local v = Validate.boolean()
		accepts(v, true); accepts(v, false)
		rejects(v, 0); rejects(v, "false"); rejects(v, nil)
	end)
	check("oneOf accepts only listed strings", function()
		local v = Validate.oneOf({ "Equip", "Drop" })
		accepts(v, "Equip"); accepts(v, "Drop")
		rejects(v, "equip"); rejects(v, "Unknown"); rejects(v, 1)
	end)
	check("oneOf snapshots choices instead of following later mutation", function()
		local choices = { "Equip", "Drop" }
		local v = Validate.oneOf(choices)
		choices[1] = "Admin"; table.insert(choices, "New")
		accepts(v, "Equip"); rejects(v, "Admin"); rejects(v, "New")
	end)
	check("optional accepts nil and still validates present values", function()
		local v = Validate.optional(Validate.boolean())
		accepts(v, nil); accepts(v, false); accepts(v, true)
		rejects(v, "true"); rejects(v, 1)
	end)
	check("array accepts empty and dense arrays up to the limit", function()
		local v = Validate.array(Validate.integer(0, 9), 3)
		accepts(v, {}); accepts(v, { 0, 4, 9 })
	end)
	check("array rejects overflow and invalid elements", function()
		local v = Validate.array(Validate.integer(0, 9), 3)
		rejects(v, { 1, 2, 3, 4 }); rejects(v, { 1, "2" }); rejects(v, { 10 })
	end)
	check("array rejects holes even when the length operator is ambiguous", function()
		local v = Validate.array(Validate.integer(0, 9), 5)
		rejects(v, { [1] = 1, [3] = 3 }); rejects(v, { [2] = 2 })
	end)
	check("array rejects string, zero, negative and fractional keys", function()
		local v = Validate.array(Validate.integer(0, 9), 5)
		rejects(v, { 1, extra = 2 }); rejects(v, { [0] = 1 })
		rejects(v, { [-1] = 1 }); rejects(v, { [1.5] = 1 })
	end)
	check("array rejects metatables including protected metatables", function()
		local v = Validate.array(Validate.integer(0, 9), 5)
		rejects(v, setmetatable({ 1 }, {}))
		rejects(v, setmetatable({ 1 }, { __metatable = false }))
	end)
	check("array rejects non-tables", function()
		local v = Validate.array(Validate.boolean(), 2)
		rejects(v, nil); rejects(v, ""); rejects(v, 0)
	end)
	check("nested finite array schemas reject cycles instead of recursing forever", function()
		local v = Validate.array(Validate.array(Validate.string(8), 2), 2)
		local cyclic = {}; cyclic[1] = cyclic
		rejects(v, cyclic)
		accepts(v, { { "safe" }, {} })
	end)
	check("record validates required fields and accepts false", function()
		local v = Validate.record({ id = Validate.string(8, 1), enabled = Validate.boolean() })
		accepts(v, { id = "pet", enabled = false })
		rejects(v, { id = "pet" }); rejects(v, { enabled = true }); rejects(v, { id = "", enabled = true })
	end)
	check("record permits an omitted optional field but rejects its invalid value", function()
		local v = Validate.record({ id = Validate.string(8, 1), amount = Validate.optional(Validate.integer(1, 3)) })
		accepts(v, { id = "pet" }); accepts(v, { id = "pet", amount = 3 })
		rejects(v, { id = "pet", amount = 0 }); rejects(v, { id = "pet", amount = "2" })
	end)
	check("record rejects unknown string and numeric fields", function()
		local v = Validate.record({ id = Validate.string(8) })
		rejects(v, { id = "pet", admin = true }); rejects(v, { id = "pet", [1] = true })
	end)
	check("record rejects metatables without consulting their fake fields", function()
		local v = Validate.record({ id = Validate.string(8) })
		rejects(v, setmetatable({}, { __index = { id = "pet" } }))
		rejects(v, setmetatable({ id = "pet" }, { __metatable = "hidden" }))
	end)
	check("record rejects non-tables and invalid nested payloads", function()
		local v = Validate.record({ ids = Validate.array(Validate.string(4, 1), 2) })
		rejects(v, nil); rejects(v, "payload")
		rejects(v, { ids = { "ok", "too long" } })
		accepts(v, { ids = { "ok" } })
	end)
	check("record snapshots its field schema before later additions and replacements", function()
		local fields = { id = Validate.string(8, 1) }
		local v = Validate.record(fields)
		fields.id = Validate.number(1, 9); fields.admin = Validate.boolean()
		accepts(v, { id = "original" })
		rejects(v, { id = 1 }); rejects(v, { id = "pet", admin = true })
	end)
	check("finite nested record schemas reject cyclic payloads", function()
		local v = Validate.record({ child = Validate.record({ value = Validate.integer(0, 9) }) })
		local cyclic = {}; cyclic.child = cyclic
		rejects(v, cyclic)
		accepts(v, { child = { value = 4 } })
	end)
	check("empty record schema accepts only a plain empty table", function()
		local v = Validate.record({})
		accepts(v, {}); rejects(v, { unexpected = false })
		rejects(v, setmetatable({}, {}))
	end)

	check("limiter grants exactly its initial burst then reports the next-token delay", function()
		local now = 0
		local limiter = RateLimiter.new(3, 2, function() return now end)
		for _ = 1, 3 do
			local allowed, retry = limiter:Allow(7); assert(allowed); close(retry, 0)
		end
		local allowed, retry = limiter:Allow(7); assert(not allowed); close(retry, 0.5)
	end)
	check("limiter refills fractionally and repeated denials do not postpone refill", function()
		local now = 0
		local limiter = RateLimiter.new(1, 2, function() return now end)
		assert(limiter:Allow(7))
		now = 0.25
		local allowed, retry = limiter:Allow(7); assert(not allowed); close(retry, 0.25)
		now = 0.4
		allowed, retry = limiter:Allow(7); assert(not allowed); close(retry, 0.1)
		now = 0.5; assert(limiter:Allow(7))
	end)
	check("limiter caps a long idle refill at capacity", function()
		local now = 0
		local limiter = RateLimiter.new(2, 1, function() return now end)
		assert(limiter:Allow(7)); assert(limiter:Allow(7))
		now = 100
		assert(limiter:Allow(7)); assert(limiter:Allow(7)); assert(not limiter:Allow(7))
	end)
	check("limiter isolates players including zero and negative test IDs", function()
		local now = 0
		local limiter = RateLimiter.new(1, 1, function() return now end)
		assert(limiter:Allow(0)); assert(limiter:Allow(1)); assert(limiter:Allow(2)); assert(limiter:Allow(-1))
		assert(not limiter:Allow(0)); assert(not limiter:Allow(1)); assert(not limiter:Allow(2)); assert(not limiter:Allow(-1))
	end)
	check("limiter refills independent buckets from their own use times", function()
		local now = 0
		local limiter = RateLimiter.new(1, 1, function() return now end)
		assert(limiter:Allow(1))
		now = 0.5; assert(limiter:Allow(2)); assert(not limiter:Allow(1))
		now = 1; assert(limiter:Allow(1)); assert(not limiter:Allow(2))
		now = 1.5; assert(limiter:Allow(2))
	end)
	check("Forget replenishes only the forgotten player's bucket", function()
		local limiter = RateLimiter.new(1, 1, function() return 0 end)
		assert(limiter:Allow(1)); assert(limiter:Allow(2))
		limiter:Forget(1)
		assert(limiter:Allow(1)); assert(not limiter:Allow(2))
		limiter:Forget(999)
		assert(not limiter:Allow(1))
	end)
	check("Clear replenishes every bucket and can be called repeatedly", function()
		local limiter = RateLimiter.new(1, 1, function() return 0 end)
		assert(limiter:Allow(1)); assert(limiter:Allow(2))
		limiter:Clear(); limiter:Clear()
		assert(limiter:Allow(1)); assert(limiter:Allow(2))
		assert(not limiter:Allow(1))
	end)
	check("backward clock movement cannot mint tokens or reverse the bucket watermark", function()
		local now = 0
		local limiter = RateLimiter.new(1, 1, function() return now end)
		assert(limiter:Allow(1))
		now = 1; assert(limiter:Allow(1))
		now = 0.5; assert(not limiter:Allow(1))
		now = 1
		local allowed, retry = limiter:Allow(1); assert(not allowed); close(retry, 1)
		now = 2; assert(limiter:Allow(1))
	end)
	check("limiter supports its default clock", function()
		local limiter = RateLimiter.new(1, 1)
		local allowed, retry = limiter:Allow(123)
		assert(allowed); close(retry, 0)
	end)
	check("limiter rejects invalid capacities and refill rates", function()
		for _, capacity in ipairs({ 0, -1, 1.5, math.huge, -math.huge, 0 / 0 }) do
			throws(function() RateLimiter.new(capacity, 1) end)
		end
		for _, rate in ipairs({ 0, -1, math.huge, -math.huge, 0 / 0 }) do
			throws(function() RateLimiter.new(1, rate) end)
		end
		throws(function() RateLimiter.new("1", 1) end)
		throws(function() RateLimiter.new(1, "1") end)
	end)
	check("limiter rejects invalid user IDs on Allow and Forget", function()
		local limiter = RateLimiter.new(1, 1, function() return 0 end)
		for _, id in ipairs({ 0.5, math.huge, -math.huge, 0 / 0, "1", false, {} }) do
			throws(function() limiter:Allow(id) end)
			throws(function() limiter:Forget(id) end)
		end
		throws(function() limiter:Allow(nil) end)
		throws(function() limiter:Forget(nil) end)
	end)
	check("limiter rejects invalid clock functions and clock readings", function()
		throws(function() RateLimiter.new(1, 1, "clock") end)
		for _, reading in ipairs({ math.huge, -math.huge, 0 / 0, "0", false }) do
			throws(function() RateLimiter.new(1, 1, function() return reading end):Allow(1) end)
		end
		throws(function() RateLimiter.new(1, 1, function() return nil end):Allow(1) end)
		throws(function() RateLimiter.new(1, 1, function() error("clock failed") end):Allow(1) end)
	end)
	check("a bad clock reading after creation fails without granting a request", function()
		local now = 0
		local limiter = RateLimiter.new(1, 1, function() return now end)
		assert(limiter:Allow(1))
		now = math.huge; throws(function() limiter:Allow(1) end)
		now = 0; assert(not limiter:Allow(1))
	end)

	check("composed schemas reject truthy nonboolean custom validator results", function()
		local nonboolean = function() return "invalid" end
		assert(not Validate.array(nonboolean, 1)({ "anything" }))
		assert(not Validate.record({ item = nonboolean })({ item = "anything" }))
	end)
	return report
end
